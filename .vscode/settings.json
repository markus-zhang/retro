{
    "chat.agent.enabled": false,
    "editor.scrollbar.horizontal": "visible",
    "editor.scrollbar.vertical": "visible",
    "workbench.editor.titleScrollbarVisibility": "visible",
    "asm-code-lens.assembler": "nasm (x86)",
    "files.associations": {
        "*.{asm,inc,s,nasm,yasm,------------------------------------------}": "asm-x86-nasm"
    },
    "files.autoSave": "afterDelay",
    "chat.disableAIFeatures": true,
    "editor.fontSize": 15,
    "accessibility.verboseChatProgressUpdates": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "extensions.autoUpdateDelay": 200000000,
    "update.enableWindowsBackgroundUpdates": false,
    "update.mode": "none",
    "update.titleBar": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "bash (MSYS2)": {
            "path": "C:\\msys64\\usr\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ],
            "env": {
                "CHERE_INVOKING": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "bash (MSYS2)",
    "git.path": "C:\\dev\\Git\\bin\\git.exe"
}